{
  "name": "foundry-audiolog",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/build-manifest.mjs",
    "deploy": "bash scripts/deploy.sh",
    "dev": "vite build --watch",
    "ci": "npm run typecheck && npm run test && npm run build",
    "zip": "npm run build && cd dist && zip -r ../foundry-audiolog.zip .",
    "link:foundry": "node scripts/link-foundry.mjs"
  },
  "devDependencies": {
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#0e35b7743a5c4aaeaef8bf379bfc7088cb7e6f61",
    "typescript": "^5.6.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
