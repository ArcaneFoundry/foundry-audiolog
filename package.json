{
  "name": "foundry-audiolog",
  "version": "0.1.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/build-manifest.mjs",
    "dev": "vite build --watch",
    "ci": "npm run typecheck && npm run test && npm run build",
    "zip": "npm run build && cd dist && zip -r ../foundry-audiolog.zip .",
    "link:foundry": "node scripts/link-foundry.mjs"
  },
  "devDependencies": {
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#28dd024cea08b262ac5af25798d9455e34a8ec5c",
    "typescript": "^5.6.0",
    "vite": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
